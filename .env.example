# The hub's settings. scripts/install-hub.sh writes a real .env (with a random token) on first install.
PORT=7420
# Agents send this as "Authorization: Bearer <token>". Generate one with: openssl rand -hex 24
OVERSEER_TOKEN=change-me
# How the hub lists itself
HUB_ID=hub
HUB_NAME="My hub"
HUB_GROUP=tailnet
HUB_PLACE="Tailnet"
